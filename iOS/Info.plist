<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSBonjourServices</key>
	<array>
		<string>_couchpad._tcp</string>
	</array>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Couchpad uses your local network to find your Mac and control it.</string>
	<key>NSCameraUsageDescription</key>
	<string>Couchpad uses the camera to scan the pairing code shown on your Mac.</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>Couchpad pairing link</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>couchpad</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
